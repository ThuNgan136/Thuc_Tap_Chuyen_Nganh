<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <title>NFlower</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
            href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Roboto:wght@400;500;700&display=swap"
            rel="stylesheet">

    <!-- Icon Fonts -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries -->
    <link href="lib/animate/animate.min.css" rel="stylesheet">
    <link href="lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template CSS -->
    <link href="css/style.css" rel="stylesheet">
</head>

<body style="font-family: 'Rockwell Extra Bold', sans-serif; background-color: #ddcecf;">

<!-- Header -->
<div class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-3">
    <div class="container">
        <p>
            <i class="bi bi-flower1 me-2" style="color:#ffb6c1; font-size:28px;"></i>
            <span style="color:#ffb6c1; font-family: 'Playfair Display', serif; font-size:28px;">NFlowers</span>
        </p>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div id="menu" class="collapse navbar-collapse">
            <div class="navbar-nav ms-auto">
                <a href="/" class="nav-item nav-link">Home</a>
                <a href="/pages" class="nav-item nav-link">Pages</a>
                <a href="/shop" class="nav-item nav-link">Shop</a>
                <a href="/contact" class="nav-item nav-link">Contact</a>
            </div>
            <a href="/cart" class="cart-icon"  style="position:relative;">
                <i class="fa fa-shopping-cart"></i>
                <span id="cart-count"></span>
            </a>

                {{#if user}}
                    <span style="color:#ffb6c1; margin-right:12px;">Welcome, {{user.email}}</span>
                    <button id="logoutBtn"
                            style="color:#ffb6c1; border:2px solid #ffb6c1; background-color:transparent; border-radius:6px; padding:6px 16px;
                            cursor:pointer; transition:0.3s;"><a href="/logout">Logout</a>

                    </button>
                {{else}}
                    <a href="/login"
                       class="nav-item nav-link"
                       style="color:#ffb6c1; border:2px solid #ffb6c1; background-color:transparent; border-radius:6px; padding:6px 16px; transition:0.3s;">
                        Login
                    </a>

                    <a href="/signup"
                       class="nav-item nav-link"
                       style="color:#ffb6c1; border:2px solid #ffb6c1; background-color:transparent; border-radius:6px; padding:6px 16px; transition:0.3s;">
                        Sign Up
                    </a>
                {{/if}}
            </div>
        </div>
    </div>
</div>

<!-- Body -->
{{{body}}}

<!-- Footer -->
<footer class="bg-dark text-white text-center py-4">
    <p class="mb-0">&copy; 2025 NFlower</p>
    <div class="mt-2">
        <a href="#" class="text-white me-3"><i class="fab fa-facebook"></i></a>
        <a href="#" class="text-white me-3"><i class="fab fa-instagram"></i></a>
        <a href="#" class="text-white"><i class="fab fa-twitter"></i></a>
    </div>
</footer>

<!-- JS Libraries -->
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="lib/wow/wow.min.js"></script>
<script src="lib/owlcarousel/owl.carousel.min.js"></script>

<!-- Main JS -->
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const logoutBtn = document.getElementById("logoutBtn");
        if (logoutBtn) {
            logoutBtn.addEventListener("click", async () => {
                const res = await fetch("/logout", { method: "POST" });
                const result = await res.json();
                if (res.ok) {
                    window.location.reload();
                } else {
                    alert(result.message);
                }
            });
        }
    });
</script>

</body>
</html>

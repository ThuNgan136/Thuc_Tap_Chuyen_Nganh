<div id="flowerCarousel" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner">

        <!-- Banner -->
        <div class="carousel-item active">
            <img src="{{setting.pagesBannerImage}}"
                 class="d-block w-100"
                 alt="Banner"
                 height="300">

            <div class="carousel-caption d-flex flex-column justify-content-center align-items-center text-center"
                 style="top:0; bottom:0;">
                <h1 style="font-family:'Playfair Display', serif; color:#221f1b;">
                    <span>{{setting.pagesTitle}}</span>
                </h1>
                <p style="color:#221f1b;">
                    {{setting.pagesSubtitle}}
                </p>
            </div>
        </div>

        <!-- Content -->
        <section class="about-section container" style="background-color:#F5F5F5">
            <div class="row align-items-center">

                <div class="col-md-6" style="font-family:'Playfair Display', serif;">
                    <h1>
                        {{setting.pagesHeading}}
                    </h1>
                    <p>
                        {{setting.pagesContent}}
                    </p>
                </div>

                <div class="col-md-6 text-center">
                    <img src="{{setting.pagesImage}}"
                         alt="Pages Image"
                         class="img-fluid rounded">
                </div>

            </div>
        </section>

    </div>
</div>

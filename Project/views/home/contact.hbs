<section class="contact-page">

    <div class="container py-5">
        <div class="row g-4 align-items-center">


            <div class="col-lg-6">
                {{#if setting.contactImage}}
                    <img src="{{setting.contactImage}}" alt="Flowers"
                         class="img-fluid contact-img rounded-4 shadow-sm">
                {{else}}
                    <img src="/img/13.jpg" alt="Flowers"
                         class="img-fluid contact-img rounded-4 shadow-sm">
                {{/if}}
            </div>


            <div class="col-lg-6">
                <h2 class="mb-3" style="color:#6b3f2a; font-family: 'Playfair Display', serif;">Contact NFlowers</h2>
                <p class="mb-4" style="color:#4a4a4a;">
                    We’re always happy to advise and take flower orders for any occasion.<br>
                    Please fill out the form below or contact us directly.
                </p>

                <ul class="list-unstyled contact-info mb-4">
                    <p><strong>Address:</strong> {{setting.address}}</p>
                    <p><strong>Hotline:</strong> {{setting.hotline}}</p>
                    <p><strong>Email:</strong> {{setting.email}}</p>
                    <p><strong>Opening Hours:</strong> {{setting.openingHours}}</p>


                </ul>
                <form action="/contact/send" method="POST" class="row g-2">
                    <div class="col-sm-6">
                        <input type="text" name="name" class="form-control" placeholder="Full name" required>
                    </div>

                    <div class="col-sm-6">
                        <input type="email" name="email" class="form-control" placeholder="Email" required>
                    </div>

                    <div class="col-12">
                        <input type="text" name="phone" class="form-control" placeholder="Phone number">
                    </div>

                    <div class="col-12">
        <textarea name="message" class="form-control" rows="4"
                  placeholder="Your message / Request" required></textarea>
                    </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-outline-secondary px-3 py-2">
                            Send message
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</section>



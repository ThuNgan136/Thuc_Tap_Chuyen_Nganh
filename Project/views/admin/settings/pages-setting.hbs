<h2 class="mb-4">Pages Settings</h2>

<form method="POST" class="row g-3">

    <div class="col-md-6">
        <label class="form-label">Pages Title</label>
        <input type="text" name="pagesTitle" class="form-control" value="{{setting.pagesTitle}}">
    </div>

    <div class="col-md-6">
        <label class="form-label">Pages Subtitle</label>
        <input type="text" name="pagesSubtitle" class="form-control" value="{{setting.pagesSubtitle}}">
    </div>

    <div class="col-12">
        <label class="form-label">Banner Image (URL)</label>
        <input type="text" name="pagesBannerImage" class="form-control" value="{{setting.pagesBannerImage}}">
    </div>

    <div class="col-12">
        <label class="form-label">Heading</label>
        <input type="text" name="pagesHeading" class="form-control" value="{{setting.pagesHeading}}">
    </div>

    <div class="col-12">
        <label class="form-label">Content</label>
        <textarea name="pagesContent" class="form-control" rows="4">{{setting.pagesContent}}</textarea>
    </div>

    <div class="col-12">
        <label class="form-label">Main Image (URL)</label>
        <input type="text" name="pagesImage" class="form-control" value="{{setting.pagesImage}}">
    </div>

    <div class="col-12 text-center mt-3">
        <button type="submit" class="btn btn-primary px-4">Save</button>
    </div>

</form>

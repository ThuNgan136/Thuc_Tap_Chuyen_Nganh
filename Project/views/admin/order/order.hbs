<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #f5f5f5;
        margin: 20px;
    }

    .order-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 20px;
        background-color: #fff;
        border-radius: 12px;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
    }

    .order-container h2 {
        text-align: center;
        color: #333;
        margin-bottom: 25px;
    }

    .order-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .order-item {
        border: 1px solid #ddd;
        padding: 15px 20px;
        margin-bottom: 15px;
        border-radius: 8px;
        transition: box-shadow 0.2s;
    }

    .order-item:hover {
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .order-item strong {
        color: #555;
    }

    .order-item .order-status {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 5px;
        font-size: 0.9em;
        font-weight: bold;
        color: #fff;
    }

    .order-status.pending { background-color: #f0ad4e; }
    .order-status.completed { background-color: #5cb85c; }
    .order-status.cancelled { background-color: #d9534f; }
</style>

<div class="order-container">
    <h2>Danh sách đơn hàng</h2>

    {{#if orders.length}}
        <ul class="order-list">
            {{#each orders}}
                <li class="order-item">
                    <p><strong>Khách hàng:</strong> {{this.customer.name}}</p>
                    <p><strong>Phone:</strong> {{this.customer.phone}}</p>
                    <p><strong>Địa chỉ:</strong> {{this.customer.address}}</p>
                    <p><strong>Tổng tiền:</strong> {{this.total}}₫</p>
                    <p><strong>Thanh toán:</strong> {{this.customer.payment}}</p>
                    <p>
                        <strong>Trạng thái:</strong>
                        <span class="order-status {{this.status}}">
                            {{this.status}}
                        </span>
                    </p>
                    <p><strong>Ngày đặt:</strong> {{this.createdAt}}</p>
                </li>
            {{/each}}
        </ul>
    {{else}}
        <p>Chưa có đơn hàng nào.</p>
    {{/if}}
</div>

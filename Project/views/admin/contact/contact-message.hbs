<div class="container-fluid px-4">
    <h1 class="mt-4">Contact Messages</h1>
    <p class="text-muted">Danh sách liên hệ từ khách hàng</p>

    <div class="card mb-4 shadow-sm">
        <div class="card-header">
            <i class="fas fa-envelope me-1"></i>
            Messages
        </div>

        <div class="card-body">
            {{#if contacts.length}}
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Họ tên</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th>Nội dung</th>
                            <th>Ngày gửi</th>
                        </tr>
                        </thead>
                        <tbody>
                        {{#each contacts}}
                            <tr>
                                <td>{{@index}}</td>
                                <td>{{this.name}}</td>
                                <td>{{this.email}}</td>
                                <td>{{this.phone}}</td>
                                <td style="max-width:300px; white-space: pre-wrap;">
                                    {{this.message}}
                                </td>
                                <td>
                                    {{this.createdAt}}
                                </td>
                            </tr>
                        {{/each}}
                        </tbody>
                    </table>
                </div>
            {{else}}
                <p class="text-center text-muted">Chưa có tin nhắn nào</p>
            {{/if}}
        </div>
    </div>
</div>
